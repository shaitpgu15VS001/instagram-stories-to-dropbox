.avatar__image { border-radius: 50%; height: auto; object-fit: cover; width=
: 100%; }

.avatar__button { bottom: 0px; display: block; height: 50px; position: abso=
lute; right: 0px; transform: scale(1); transition: transform 0.2s ease-in-o=
ut; width: 50px; }

.avatar__button:hover { transform: scale(1.1); }

.avatar__icon { cursor: pointer; }

.avatar__icon rect:first-of-type { fill: rgb(1, 236, 165); }

.avatar__icon rect:last-of-type { stroke: rgb(255, 255, 255); }

